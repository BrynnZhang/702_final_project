knitr::opts_chunk$set(echo = TRUE)
library(dplyr)
# Load the cleaned data
gdp_clean <- read.csv("data/gdp_clean.csv")
library(dplyr)
# Load the cleaned data
gdp_clean <- read.csv("gdp_clean.csv")
gini_clean <- read.csv("gini_clean.csv")
lifeexp_clean <- read.csv("lifeexp_clean.csv")
# Merge life expectancy + gini + gdp
rq1_data <- lifeexp_clean %>%
inner_join(gini_clean, by = c("Country", "Year")) %>%
inner_join(gdp_clean, by = c("Country", "Year")) %>%
group_by(Country) %>%
slice_max(Year, n = 1) %>%   # Use each country's most recent year
ungroup()
# Preview merged data
glimpse(rq1_data)
# Save merged file if desired
write.csv(rq1_data, "data/rq1_merged.csv", row.names = FALSE)
library(dplyr)
# Load cleaned datasets
gdp_clean <- read.csv("gdp_clean.csv")
gini_clean <- read.csv("gini_clean.csv")
sust_clean <- read.csv("UNSust_clean.csv")
# Fix inconsistent column names
sust_clean <- sust_clean %>%
rename(
Country = `Country or Area`,
Sustainability = Value
)
library(dplyr)
# Load cleaned datasets
gdp_clean <- read.csv("gdp_clean.csv")
gini_clean <- read.csv("gini_clean.csv")
sust_clean <- read.csv("UNSust_clean.csv")
# Fix inconsistent column names
sust_clean <- sust_clean %>%
rename(
Country = Country.or.Area,
Sustainability = Value
)
# Merge sustainability + gini + gdp
rq2_data <- sust_clean %>%
inner_join(gini_clean, by = c("Country", "Year")) %>%
inner_join(gdp_clean, by = c("Country", "Year")) %>%
group_by(Country) %>%
slice_max(Year, n = 1) %>%   # use each country's most recent common year
ungroup()
# Preview merged dataset
glimpse(rq2_data)
# Optional — save merged dataset
write.csv(rq2_data, "rq2_merged.csv", row.names = FALSE)
library(readr)
library(dplyr)
library(ggplot2)
rq2_raw <- read_csv("rq2_merged.csv")
dim(rq2_raw)
head(rq2_raw)
summary(rq2_raw)
rq2_panel <- rq2_raw %>%
rename(
Country        = Country,
Year           = Year,
Sustainability = Sustainability,
Gini           = Gini,
GDP            = GDP
) %>%
mutate(
log_GDP = log(GDP)
) %>%
filter(
!is.na(Sustainability),
!is.na(Gini),
!is.na(GDP),
is.finite(log_GDP)
)
dim(rq2_panel)
summary(select(rq2_panel, Sustainability, Gini, GDP, log_GDP, Year))
rq2_panel <- rq2_raw %>%
mutate(
log_GDP = log(GDP)   # log-transform GDP to reduce skewness
) %>%
filter(
!is.na(Sustainability),
!is.na(Gini),
!is.na(GDP),
is.finite(log_GDP)
)
dim(rq2_panel)
summary(select(rq2_panel, Sustainability, Gini, GDP, log_GDP, Year))
model_rq2_panel <- lm(
Sustainability ~ Gini + log_GDP + factor(Year),
data = rq2_panel
)
summary(model_rq2_panel)
panel_partial <- rq2_panel %>%
mutate(
resid_Sust = resid(lm(Sustainability ~ log_GDP + factor(Year), data = rq2_panel)),
resid_Gini = resid(lm(Gini ~ log_GDP + factor(Year), data = rq2_panel))
)
ggplot(panel_partial, aes(x = resid_Gini, y = resid_Sust)) +
geom_point(alpha = 0.6) +
geom_smooth(method = "lm", se = FALSE, color = "blue") +
labs(
x = "Gini residualized on log GDP and Year",
y = "Sustainability residualized on log GDP and Year",
title = "Partial Relationship: Sustainability vs Inequality (net of GDP and Year)"
)
ggplot(rq2_panel, aes(x = Gini, y = Sustainability)) +
geom_point(alpha = 0.7) +
geom_smooth(method = "lm", se = FALSE, color = "blue") +
labs(
x = "Gini index (0 = equality, 100 = inequality)",
y = "Sustainability rating (1–6)",
title = "Sustainability vs Inequality (raw bivariate relationship)"
)
ggplot(rq2_panel, aes(x = log_GDP, y = Sustainability)) +
geom_point(alpha = 0.7) +
geom_smooth(method = "lm", se = FALSE, color = "blue") +
labs(
x = "log(GDP per capita, PPP)",
y = "Sustainability rating (1–6)",
title = "Sustainability vs log(GDP) (raw bivariate relationship)"
)
year_counts <- rq2_panel %>%
count(Year, name = "n_countries") %>%
arrange(desc(n_countries))
year_counts
# Filter to the chosen year (2019)
rq2_2019 <- rq2_panel %>%
filter(Year == 2019)
# Fit the cross-sectional regression
model_rq2_cross <- lm(
Sustainability ~ Gini + log_GDP,
data = rq2_2019
)
summary(model_rq2_cross)
